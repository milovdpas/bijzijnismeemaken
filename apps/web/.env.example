# Copy to .env.local. Both values are NEXT_PUBLIC_, so they are inlined into
# the browser bundle at BUILD time; in the Docker image they come in as build
# arguments, not runtime environment.

# Where the browser reaches the API. Locally the API runs on 4000; in
# production this is https://api.bijzijn.milovanderpas.nl.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The app's own public origin, used for canonical URLs and the manifest.
NEXT_PUBLIC_APP_URL=http://localhost:3000
