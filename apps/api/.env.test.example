# Copy to .env.test. Used only when NODE_ENV=test, which vitest sets itself.
#
# Create the database once (on the bundled container, port 3308, user root /
# password bzim):
#
#   CREATE DATABASE bzim_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   GRANT ALL ON bzim_test.* TO 'bzim'@'%';
#
# The suite migrates it on every run and truncates every table before every
# test, so it must be a database whose contents nobody minds losing.
#
# DB_NAME must end in "_test". The test bootstrap refuses to run otherwise, and
# also refuses if this file is missing, because dotenv would then quietly fall
# back to whatever DB_* variables are already in the environment, which on a
# developer machine is usually the development database.

NODE_ENV=test

DB_HOST=localhost
DB_PORT=3308
DB_USER=bzim
DB_PASSWORD=bzim
DB_NAME=bzim_test

# The worker tests send this value; anything non-empty works.
WORKER_TOKEN=test-worker-token

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
COOKIE_DOMAIN=
JWT_SECRET=test-jwt-secret-that-is-long-enough-for-hs256
