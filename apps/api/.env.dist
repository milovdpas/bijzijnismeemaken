# Deployment template. Committed on purpose, and it holds no secrets.
#
# CI renders it with envsubst, which replaces every $NAME below with the
# matching environment variable and leaves the literal lines alone:
#
#   envsubst < .env.dist > .env
#
# A name that is not set in the environment substitutes to an empty string
# rather than failing, so anything required is checked after rendering in
# .github/workflows/deploy-api.yml.
#
# Everything optional below is written so that empty means the safe answer: the
# code treats a blank value as unset and applies its own default, so a variable
# nobody has configured cannot turn something on.

NODE_ENV=production
PORT=3000

# How many reverse proxies sit between a caller and this process, which decides
# what req.ip is. Unset renders as empty, which falls back to the code's
# production default of 1 (one nginx).
TRUST_PROXY_HOPS=$TRUST_PROXY_HOPS

# MySQL, because the production hosting offers nothing else.
DB_HOST=$DB_HOST
DB_PORT=$DB_PORT
DB_USER=$DB_USER
DB_PASSWORD=$DB_PASSWORD
DB_NAME=$DB_NAME

# Shared secret for POST /api/v1/worker/*, which the Ofelia scheduler calls from
# inside the container. Nothing else may call it.
WORKER_TOKEN=$WORKER_TOKEN

# Public hostnames and the cookie scope the JWT cookies are set on. Read from
# task 7 (auth) onwards; harmless placeholders until then.
APP_URL=$APP_URL
API_URL=$API_URL
COOKIE_DOMAIN=$COOKIE_DOMAIN
JWT_SECRET=$JWT_SECRET

# Encrypts columns at rest. Never rotate casually: see .env.example.
APP_KEY=$APP_KEY

# Google OAuth client (login and, later, calendar). Read from task 8 onwards.
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET

# Transactional email through Brevo (verification, reset, invites, planned
# activities). The sender must be an authenticated sender in Brevo.
MAIL_DRIVER=brevo
MAIL_FROM_EMAIL=$MAIL_FROM_EMAIL
MAIL_FROM_NAME=$MAIL_FROM_NAME
BREVO_API_KEY=$BREVO_API_KEY

# 32 random bytes, base64, used to encrypt calendar refresh tokens at rest. Read
# from task 33 onwards.
CALENDAR_TOKEN_KEY=$CALENDAR_TOKEN_KEY
