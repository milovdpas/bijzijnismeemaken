# Copy to .env and fill in. Never commit the real file.
#
# Every secret stays server-side. Nothing here may be moved into apps/web:
# anything prefixed NEXT_PUBLIC_ ships inside the browser bundle.

NODE_ENV=development
PORT=4000

# Reverse proxies between a caller and this process, which is what decides
# whether req.ip is the browser or the proxy. The rate limiters key on it.
# Defaults to 1 when NODE_ENV is production (nginx owns ingress there) and 0
# otherwise. Left commented out on purpose: an uncommented 0 copied into a
# production .env would put every caller behind nginx into one bucket.
# TRUST_PROXY_HOPS=1

# MySQL, because the production hosting only offers MySQL.
#
# Defaults below target the bundled container: run `npm run docker:up` from the
# repo root. For a local MySQL install, change the port and credentials.
DB_HOST=localhost
DB_PORT=3308
DB_USER=bzim
DB_PASSWORD=bzim
DB_NAME=bzim

# Shared secret for the POST /api/v1/worker/* endpoints, which the Ofelia
# scheduler calls from inside the container. Locally, set anything and send the
# same value as X-Worker-Token (or run `npm run worker -w @bzim/api -- cleanup`).
# Empty means the routes answer 503, which is deliberate: an unguarded worker
# endpoint is a stranger's loop running our cron jobs.
WORKER_TOKEN=local-worker-token

# Where the web app runs; the only origin CORS lets read responses and the
# target of every post-login redirect. The API's own origin is what the OAuth
# callback URLs registered with Google must match.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Domain attribute of the session cookies. Leave it empty: the cookie is then
# host-only on the API hostname, which is what both localhost and production
# want (the app and the API are sibling hostnames under milovanderpas.nl and
# same-site requests carry a host-only Lax cookie). Only set it when the two
# hostnames share a parent that belongs to this app alone.
COOKIE_DOMAIN=

# Signs the access and refresh tokens. Generate: openssl rand -base64 48
JWT_SECRET=

# Google OAuth client (console.cloud.google.com, "Web application"). Authorised
# redirect URI: <API_URL>/api/v1/auth/google/callback. Read lazily: the API
# boots without them and the Google button fails until they are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How email leaves the API. `console` prints it to the log, `smtp` talks to any
# SMTP server (the bundled mailpit on port 1025 with UI on 8025, a Mailtrap
# sandbox, or a real relay), `brevo` uses Brevo's HTTP API and is the production
# default. Unset means console outside production and brevo in production.
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave the user empty for an unauthenticated catcher such as mailpit.
SMTP_USER=
SMTP_PASSWORD=
# true only for implicit TLS on port 465; 587 and 2525 use STARTTLS with false.
SMTP_SECURE=false
MAIL_FROM_EMAIL=noreply@milovanderpas.nl
MAIL_FROM_NAME=Bij zijn is meemaken
# Only read when MAIL_DRIVER=brevo.
BREVO_API_KEY=

# Unsplash access key (unsplash.com/developers, free) for the photo search in the
# activity form.
# Empty disables the search; pasting an image link still works.
UNSPLASH_ACCESS_KEY=

# Encrypts columns at rest (emails). 32 random bytes, base64. Generate with:
#   node -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))"
# Losing or rotating it makes every encrypted column unreadable.
APP_KEY=

# Encrypts Google Calendar tokens at rest (M2). Same shape as APP_KEY, its own
# value. Optional until somebody connects a calendar.
CALENDAR_TOKEN_KEY=
