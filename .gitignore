# dependencies
node_modules/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# env: never commit real keys (Google OAuth, Brevo, JWT, calendar token key)
.env
.env.*
# Templates, not real files: examples hold empty values and .env.dist holds
# envsubst placeholders. All are meant to be committed.
!.env.example
!.env.*.example
!.env.dist

# logs
logs/
*.log
npm-debug.*

# editors / os
.DS_Store
*.pem
.idea/
.vscode/

# test output
coverage/

# database dumps, never committed: they carry user data
*.sql
